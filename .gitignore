# Credentials and machine-local connector configuration must never be
# committed.  Example/template files remain allowed explicitly.
.env
.env.*
!.env.example
*client_secret*.json
*credentials*.json
*.pem
*.p12
*.key

# Runtime databases and tokens are private even if accidentally written
# outside private-data during a failed migration.
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
socket-token.txt

themes/first-encounter/assets/generated-*
